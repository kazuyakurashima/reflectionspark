/** 【仮】点の尺度。1〜5 の整数。 */
export const SCALE = {
  min: 1,
  max: 5,
  levels: [
    { score: 1, text: "この面談では、その関わりが本文に見えない。求める場面はあった。" },
    { score: 2, text: "関わりは一度あったが、相手の続きにつながらなかった。" },
    { score: 3, text: "関わりがあり、相手が受けて続けた所が一度ある。ほかの場面では見えない。" },
    { score: 4, text: "求める場面の多くで関わりがあり、相手が自分の言葉で続けた。" },
    { score: 5, text: "求める場面のほぼすべてで関わりがあり、相手の発話がそれで動いた（長くなった、具体になった、自分で選んだ）。" },
  ],
} as const;

/** 【仮】配点。5 項目とも同じ重さ。 */
export const WEIGHTS: Record<ItemNumber, number> = { 1: 1, 2: 1, 3: 1, 4: 1, 5: 1 };

/**
 * 合計（アプリが計算する。決まり 8）。
 * 【仮】判定した項目の合計（sum）と、その上限（max = 判定した項目数 × 5）、
 * それを 10 点に換算した値（scaled）を返す。保留した項目は分母から外す（0 点にしない。決まり 9）。
 * 自己採点は合計一つ（10 点満点）で、scaled と同じ尺度で並べる。
 */
export function computeTotal(items: ItemScore[]): { sum: number; judgedCount: number; max: number; scaled: number | null } {
  const judged = items.filter((i) => i.score !== null);
  const sum = judged.reduce((s, i) => s + (i.score ?? 0) * WEIGHTS[i.item], 0);
  const max = judged.reduce((s, i) => s + SCALE.max * WEIGHTS[i.item], 0);
  const scaled = max === 0 ? null : Math.round((sum / max) * 100) / 10;
  return { sum, judgedCount: judged.length, max, scaled };
}

/** 工程 1 に渡す「読みの背景」。場面は 5 項目に縛らない（決まり 4）ので、項目の名前と考え方だけを渡す。 */
export function rubricBackground(): string {
  return RUBRIC_ITEMS.map((i) => `${i.n}. ${i.name}：${i.looksAt}`).join("\n");
}

/** 工程 2・4 に渡す採点表の全文。 */
export function rubricFull(): string {
  const items = RUBRIC_ITEMS.map(
    (i) =>
      `## 項目 ${i.n}：${i.name}
- 見るもの：${i.looksAt}
- 満たしているとき：${i.high}
- 満たしていないとき：${i.low}
- 「この面談では判定しない」にしてよい条件：${i.withhold}${i.caution ? `\n- 注意：${i.caution}` : ""}`,
  );
  const levels = SCALE.levels.map((l) => `${l.score}：${l.text}`).join("\n");
  return `${items.join("\n\n")}

## 点の尺度（1〜5 の整数）
${levels}

保留は 0 点ではなく「この面談では判定しない」。保留にしてよいのは、文字起こしが足りないときと、その項目を求める場面が今回の面談に無いと本文から示せるときだけ。求める場面があるのに関わりが見えないときは、保留にせず点を付ける。`;
}
